# Rider Application: every environment variable, in one place.
#
# Nothing here is loaded from this file directly. Copy each section to where
# that app reads it (see README.md, "Environment variables and secrets"):
#
#   [compose]  -> .env                          (next to docker-compose.yml)
#   [backend]  -> apps/backend/.development.env
#   [spa]      -> apps/spa/.env.development
#
# In production none of these files exist: set the same names as real
# environment variables (e.g. Railway > Variables, `docker run --env-file`).
# All of these files are gitignored; only this example is committed.


# ---------------------------------------------------------------------------
# [compose] .env: read by `docker compose` for the ${...} values in
# docker-compose.yml. All optional; these are the defaults.
# ---------------------------------------------------------------------------
APP_PORT=8080
POSTGRES_USER=rider
POSTGRES_PASSWORD=rider
POSTGRES_DB=rider


# ---------------------------------------------------------------------------
# [backend] apps/backend/.development.env: NestJS (ConfigModule) and Prisma.
# Under docker compose, DB_* / REDIS_* / PORT are overridden by the
# `environment:` block in docker-compose.yml to point at the containers.
# ---------------------------------------------------------------------------
PORT=3000
# development | production. In production the session cookie is Secure (HTTPS only).
NODE_ENV=development

# Signs the session JWT. Use a long random value, e.g. `openssl rand -base64 48`.
SECRET=

# PostgreSQL (Prisma)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rider
DB_PASSWORD=rider
DB_NAME=rider

# Redis (BullMQ queues + cache). REDIS_URL wins when set (Railway provides it,
# e.g. redis://default:pass@host:6379, or rediss:// for TLS).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Admin service account (push notifications), base64 of the key file:
#   base64 -w0 firebase/<project>-firebase-adminsdk-*.json
# Secret: never commit it or ship it to the SPA.
FIREBASE_SERVICE_ACCOUNT=

# Web Push certificate public key (Firebase console > Project settings >
# Cloud Messaging). Not read by the backend; the SPA uses it as
# NEXT_PUBLIC_FIREBASE_VAPID_KEY below.
FCM_KEY_PAIR=


# ---------------------------------------------------------------------------
# [spa] apps/spa/.env.development: Next.js. NEXT_PUBLIC_* values are inlined
# into the browser bundle at build time, so they must all be public.
# ---------------------------------------------------------------------------
# Where the browser reaches the API. `next dev` on its own: the backend directly.
# Under docker compose / production behind nginx: /api (compose sets this).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Firebase web app config (Firebase console > Project settings > Your apps).
# Public identifiers, safe in the browser. Leave empty to disable push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
